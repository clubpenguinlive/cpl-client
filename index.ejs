<!-- This is a template file used by webpack -->

<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">

        <!-- Mobile / installable web app -->
        <meta name="theme-color" content="#0b9ae2">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Club Penguin Live">
        <link rel="manifest" href="/manifest.json">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>">

        <!-- Favicon: classic Club Penguin (versioned to bypass stale Cloudflare cache) -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>">

        <title>Club Penguin Live</title>

        <link rel="stylesheet" href="assets/styles/styles.css?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>" type="text/css">

        <style>
            @font-face { font-family: 'ProximaNova'; src: url('assets/fonts/ProximaNova-Reg.woff2') format('woff2'); font-display: swap; }
            @font-face { font-family: 'ProximaNova'; font-weight: bold; src: url('assets/fonts/ProximaNova-Bold.woff2') format('woff2'); font-display: swap; }

            html, body { height: 100%; margin: 0; overscroll-behavior: none; }
            body {
                --nav-h: 46px;
                display: flex; flex-direction: column;
                background: #2f9fe0;
                font-family: 'ProximaNova', 'Helvetica Neue', Helvetica, Arial, sans-serif;
                color: #fff;
                -webkit-tap-highlight-color: transparent;
                -webkit-touch-callout: none;
                -webkit-user-select: none; user-select: none;
            }
            #game, #game canvas { touch-action: none; }
            input, textarea { -webkit-user-select: text; user-select: text; }

            /* CP-blue top nav — kept above the landing overlay so the menu bar shows on the home page */
            #cpl-nav {
                position: relative; z-index: 950;
                flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between;
                height: var(--nav-h); padding: 0 16px; background: #1f9fe0;
                border-bottom: 2px solid #1577b8;
                box-shadow: 0 2px 0 rgba(0,0,0,.08);
            }
            #cpl-nav .side { display: flex; align-items: center; gap: 22px; }
            #cpl-nav a { color: #fff; text-decoration: none; font-size: 16.5px; font-weight: bold; text-shadow: 0 1px 1px rgba(0,0,0,.18); }
            #cpl-nav a:hover { color: #d6efff; }
            #cpl-nav a.home { width: 22px; height: 22px; background: url('assets/media/icon-home.png') center/contain no-repeat; font-size: 0; }
            #cpl-nav a.cta {
                background: linear-gradient(#ffd23f, #ffb300); color: #5a3b00;
                padding: 8px 18px; border-radius: 999px; box-shadow: 0 3px 0 #c98a00; text-shadow: none;
            }
            #cpl-nav a.cta:hover { color: #5a3b00; transform: translateY(-1px); }
            #cpl-nav .side.right { gap: 10px; }
            .cpl-navbtn {
                font: inherit; font-weight: bold; cursor: pointer; color: #fff; font-size: 15px;
                background: #1577b8; border: 1px solid rgba(255,255,255,.35); border-radius: 999px; padding: 7px 14px;
            }
            .cpl-navbtn:hover { background: #0e5fa8; }
            #cpl-logout { background: #e6584d; border-color: rgba(255,255,255,.4); }
            #cpl-logout:hover { background: #c94539; }
            /* Log Out only makes sense once you're in-world. Hide it on the start/login screens
               (cpl-playing is added by WorldController on world join), so it doesn't show pre-login. */
            body:not(.cpl-playing) #cpl-logout { display: none; }
            /* icon-only fullscreen toggle (inline SVG, inherits the nav white) */
            .cpl-iconbtn { background: none; border: none; cursor: pointer; padding: 4px; display: inline-flex; align-items: center; color: #fff; line-height: 0; }
            .cpl-iconbtn svg { width: 22px; height: 22px; display: block; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
            .cpl-iconbtn:hover { color: #d6efff; }
            .cpl-iconbtn .ic-compress { display: none; }
            .cpl-iconbtn.is-fs .ic-expand { display: none; }
            .cpl-iconbtn.is-fs .ic-compress { display: block; }

            /* framed game stage */
            #cpl-stage { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; padding: 10px; min-height: 0; }
            /* Cap the wrapper at the game's NATIVE size (1520x960), not an arbitrary 1360 width. With the
               old 1360 cap, on a wide desktop `height:100%` drove the aspect-derived width past 1360, the
               cap clamped the width, and since height stayed at 100% the aspect-ratio was OVERRIDDEN — the
               wrapper became a too-tall 1.40 box and FIT letterboxed the 1.58 game inside it, showing the
               blue background as bands above/below. Capping HEIGHT at the native 960 keeps the
               height-derived width at/under 1520 (= the width cap), so the aspect never breaks and the
               canvas fills the wrapper. Beyond native the game holds at 1520x960 (crisp, no upscale) and
               centers on the page background — never a blue frame band. */
            #game-wrap {
                aspect-ratio: 1520 / 960; height: 100%; width: auto; max-width: min(100%, 1520px); max-height: min(100%, 960px); margin: 0 auto;
                border: 8px solid #1a73b3; border-radius: 16px; background: #0e5fa8;
                overflow: hidden; box-shadow: 0 8px 26px rgba(0,0,0,.32);
            }
            #game { width: 100%; height: 100%; }

            /* Full-screen game takeover requires BOTH: the player clicked Play Now (cpl-launched,
               landing dismissed) AND a world was joined (cpl-playing). */
            /* play.clubpenguinlive.net never shows the built-in Yukon landing — the marketing
               landing lives on clubpenguinlive.net. Hide it UNCONDITIONALLY in the initial <head>
               CSS so it never paints (no render-then-hide flash before landing.js runs). */
            #cpl-landing { display: none !important; }

            /* CPJourney chrome model: the game is ALWAYS framed, with the nav on top and footer on
               bottom — no automatic fullscreen takeover. True fullscreen is an explicit user action
               via the "Go Full Screen" nav button (Fullscreen API); exiting returns to the framed
               view. (cpl-playing is left harmless; WorldController still refits the canvas on join.) */
            #game-wrap:fullscreen {
                width: 100vw; height: 100vh; max-width: none; max-height: none;
                border: none; border-radius: 0; box-shadow: none; aspect-ratio: auto; background: #05112b;
                /* inset by the device safe area so curved corners / notch / home indicator don't clip
                   the canvas. env() is 0 on non-notched displays, so desktop fullscreen is unchanged. */
                box-sizing: border-box;
                padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
            }

            /* footer */
            #cpl-footer { flex: 0 0 auto; text-align: center; font-size: 11px; color: #eaf6ff; padding: 8px 12px; background: #1f9fe0; border-top: 2px solid #1577b8; }
            #cpl-footer nav { margin-top: 2px; }
            #cpl-footer a { color: #fff; text-decoration: none; margin: 0 5px; font-weight: bold; }
            #cpl-footer a:hover { color: #d6efff; }

            /* hamburger button: inert on desktop (display:none keeps it out of flow, so the
               nav renders byte-for-byte as before); revealed only on narrow screens below. */
            .cpl-burger { display: none; }
            @media (max-width: 760px) {
                .cpl-burger { display: block; cursor: pointer; color: #fff; font-size: 24px; line-height: 1; padding: 2px 8px; user-select: none; }
                /* collapse the left link group into a tappable dropdown (Home + the text links) */
                #cpl-nav > .side:not(.right) { display: none; }
                #cpl-nav-toggle:checked ~ .side:not(.right) {
                    display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
                    position: absolute; left: 0; top: var(--nav-h); z-index: 951; min-width: 200px;
                    background: #1f9fe0; border-bottom: 2px solid #1577b8; box-shadow: 0 6px 14px rgba(0,0,0,.28); padding: 14px 18px;
                }
                #cpl-nav-toggle:checked ~ .side:not(.right) a.home { width: auto; height: auto; background: none; font-size: 16.5px; }
            }
            @media (pointer: coarse) {
                html, body { position: fixed; inset: 0; width: 100%; height: 100%; overflow: hidden; }
            }
            @media (pointer: coarse) and (orientation: landscape) {
                body { --nav-h: 34px; }
                #cpl-nav { padding: 0 10px; }
                #cpl-footer { display: none; }
                /* Inset the stage by the safe area on the TOP and SIDES (notch / Dynamic Island / curved
                   corners) so the canvas and its top-corner icons aren't clipped. For the BOTTOM, use a
                   small fixed buffer rather than env(safe-area-inset-bottom): the full home-indicator inset
                   (~21px) left an empty strip and capped the game short, while zero ran the game right under
                   the indicator and read as tight. 8px splits the difference and is imperceptible in a
                   normal browser tab. */
                #cpl-stage { padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) 8px env(safe-area-inset-left, 0px); }
                /* Let Phaser FIT own the sizing. The framed wrapper's explicit height:100% + the
                   max-width cap together OVERRODE its aspect-ratio at landscape aspects narrower than
                   the game's 1520:960 (tablets, split view, safe-area-trimmed phones): the wrapper
                   stretched to the full viewport box, so FIT correctly letterboxed the game inside it
                   and the wrapper's blue background showed as empty bands above/below the canvas. Make
                   the wrapper span the full available area (no aspect override, no frame) so FIT scales
                   the canvas to the largest undistorted size against the real screen height, with any
                   letterbox falling on the page background instead of a blue frame band. */
                #game-wrap {
                    width: 100%; height: 100%; max-width: none; max-height: none;
                    aspect-ratio: auto; border: none; border-radius: 0; box-shadow: none; background: transparent;
                }
            }
            /* mobile (touch): the nav bar is slim (34px), so the desktop-sized Log Out pill and
               fullscreen icon overpower it (the pill renders TALLER than the bar). Scale the right-side
               controls down to the hamburger's weight and tighten the cluster so the bar reads balanced,
               not a small burger far-left and oversized buttons far-right. Desktop (fine pointer) never
               matches @media (pointer: coarse), so it stays byte-for-byte unchanged. */
            @media (pointer: coarse) {
                .cpl-burger { font-size: 21px; padding: 2px 6px; }
                #cpl-nav .side.right { gap: 8px; }
                #cpl-logout, .cpl-navbtn { font-size: 12px; padding: 4px 11px; }
                .cpl-iconbtn { padding: 3px; }
                .cpl-iconbtn svg { width: 18px; height: 18px; }
            }
            /* On mobile landscape, present the nav as three floating corner chips on EVERY screen
               (login/start and in-world alike), so the menu reads the same everywhere and the game
               canvas always gets the full height (no bar-then-collapse flash on world join). The
               canvas is FIT + CENTER_BOTH, so at phone aspect it's pillarboxed and the chips live in
               those side bands, clear of the game's in-canvas icons (star/mail top-left, M badge
               top-right). Gated on pointer:coarse so desktop (fine pointer) is byte-for-byte
               unchanged; gated on landscape because portrait shows the rotate prompt instead. */
            @media (pointer: coarse) and (orientation: landscape) {
                /* detach the nav from the flex column -> #cpl-stage (and the canvas) grow to full height.
                   pointer-events:none lets taps fall through the empty band to the game; only the chips
                   below re-enable pointer-events. */
                body #cpl-nav {
                    position: fixed; top: 0; left: 0; right: 0; height: 0; min-height: 0; padding: 0;
                    background: transparent; border: none; box-shadow: none; z-index: 970; pointer-events: none;
                }
                /* collapse the inline link row into the hamburger at ANY width (every screen) */
                body #cpl-nav > .side:not(.right) { display: none; }
                /* hamburger -> floating chip, top-left */
                body .cpl-burger {
                    display: flex; align-items: center; justify-content: center;
                    position: absolute; top: max(4px, env(safe-area-inset-top, 0px)); left: max(10px, env(safe-area-inset-left, 0px)); z-index: 972; pointer-events: auto;
                    width: 31px; height: 27px; padding: 0; font-size: 18px; line-height: 1;
                    color: #fff; background: rgba(12, 64, 104, .62); border-radius: 8px;
                }
                /* the right group is now a passthrough; fullscreen + Log Out are placed individually so
                   they can sit in different corners. display:contents drops the wrapper box, so each
                   child positions against #cpl-nav (the fixed, full-width layer), not the old right box. */
                body #cpl-nav .side.right { display: contents; }
                /* No fullscreen button on touch devices: the browser Fullscreen API is unusable on
                   iPhone (requestFullscreen is a no-op), and "full screen" on mobile is Add to Home
                   Screen. Hide it so it's not a dead control. */
                body #cpl-fullscreen { display: none; }
                /* Log Out -> TOP-RIGHT, inset off the edge (and clear of the notch/curve via the safe
                   area). The min-width rule below insets it a little further on roomier landscape phones. */
                body #cpl-logout {
                    position: absolute; top: max(4px, env(safe-area-inset-top, 0px)); right: max(10px, env(safe-area-inset-right, 0px)); z-index: 972; pointer-events: auto;
                }
                /* the link dropdown opens under the hamburger, above the canvas */
                body #cpl-nav-toggle:checked ~ .side:not(.right) {
                    display: flex; flex-direction: column; align-items: flex-start; gap: 13px;
                    position: absolute; top: 42px; left: max(10px, env(safe-area-inset-left, 0px)); z-index: 973; pointer-events: auto;
                    min-width: 178px; background: #1f9fe0; border-radius: 10px;
                    box-shadow: 0 6px 16px rgba(0,0,0,.4); padding: 13px 17px;
                }
                body #cpl-nav-toggle:checked ~ .side:not(.right) a.home {
                    width: auto; height: auto; background: none; font-size: 16.5px;
                }
            }
            /* roomier landscape phones (>= 700px wide): the right band has space to inset Log Out off
               the screen edge so the controls read balanced across the top. Below 700px the narrow-safe
               default applies. (Fullscreen button is hidden on touch, so it's not placed here.) */
            @media (pointer: coarse) and (orientation: landscape) and (min-width: 700px) {
                body #cpl-logout { right: max(18px, env(safe-area-inset-right, 0px)); }
            }

            /* ---- Animated landing (front page) ---- */
            /* starts below the nav so the CP-blue menu bar stays visible on the home page */
            #cpl-landing {
                position: fixed; inset: var(--nav-h) 0 0 0; z-index: 900; overflow: hidden;
                display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
                background: #1f9fe0;
                transition: opacity .5s ease;
            }
            /* billboard layer: cover fills the landing area exactly (no extra zoom/overscan, which
               was pushing the scene off-edge and reading as "too zoomed in"). */
            #cpl-landing::before {
                content: ''; position: absolute; inset: 0; z-index: 0;
                background: url('assets/media/mainmenu/cpl_billboard.jpg') center top / cover no-repeat;
            }
            #cpl-snow { z-index: 1; }
            #cpl-landing.hide { opacity: 0; pointer-events: none; }
            /* darken the bottom so the tagline + Play Now stay readable over the busy scene */
            #cpl-landing::after {
                content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 45%;
                background: linear-gradient(transparent, rgba(0,0,0,.6)); pointer-events: none; z-index: 1;
            }
            #cpl-snow { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
            .snowflake {
                position: absolute; top: -8%; border-radius: 50%; background: #fff; opacity: .85;
                animation-name: cpl-fall; animation-timing-function: linear; animation-iteration-count: infinite;
            }
            @keyframes cpl-fall {
                0%   { transform: translateY(-10vh) translateX(0); opacity: 0; }
                10%  { opacity: .9; }
                100% { transform: translateY(112vh) translateX(var(--drift, 20px)); opacity: .9; }
            }
            #cpl-landing .cpl-cta { position: relative; z-index: 3; text-align: center; margin-bottom: 9vh; }
            #cpl-landing .tagline {
                font-family: 'Burbank Big Regular', 'ProximaNova', sans-serif;
                font-size: clamp(20px, 3vw, 34px); color: #fff; margin: 0 0 16px;
                text-shadow: 2px 2px 8px rgba(0,0,0,.75), 0 0 20px rgba(0,0,0,.5);
            }
            .cpl-play {
                font-family: 'Burbank Big Regular', 'ProximaNova', sans-serif;
                font-size: clamp(24px, 3.4vw, 40px); letter-spacing: .5px; color: #5a3b00;
                background: linear-gradient(#ffe06a, #ffb300); border: none; cursor: pointer;
                padding: 16px 54px; border-radius: 999px; box-shadow: 0 6px 0 #c98a00, 0 10px 22px rgba(0,0,0,.3);
                transition: transform .08s, box-shadow .2s; animation: cpl-pulse 1.8s ease-in-out infinite;
            }
            .cpl-play:hover { transform: translateY(-2px); }
            .cpl-play:active { transform: translateY(5px); box-shadow: 0 1px 0 #c98a00, 0 4px 10px rgba(0,0,0,.3); }
            @keyframes cpl-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.04); } }
            /* secondary "Create a Penguin" action under Play Now */
            #cpl-landing .cpl-create {
                display: inline-block; margin-top: 36px;
                font-family: 'Burbank Big Regular', 'ProximaNova', sans-serif;
                font-size: clamp(15px, 1.7vw, 20px); color: #fff; text-decoration: none;
                background: rgba(255,255,255,.16); border: 2px solid rgba(255,255,255,.9);
                padding: 11px 32px; border-radius: 999px;
                text-shadow: 0 1px 3px rgba(0,0,0,.55); box-shadow: 0 4px 12px rgba(0,0,0,.22);
                transition: background .15s, transform .08s;
            }
            #cpl-landing .cpl-create:hover { background: rgba(255,255,255,.3); transform: translateY(-1px); }

            /* install hint banner (iOS Add-to-Home / Android install) */
            #cpl-install {
                position: absolute; top: 14px; left: 50%; transform: translateX(-50%); z-index: 4;
                display: flex; align-items: center; gap: 10px; max-width: 92vw;
                background: rgba(11,34,46,.88); color: #fff; padding: 9px 12px 9px 16px; border-radius: 999px;
                font-size: 14px; line-height: 1.25; box-shadow: 0 4px 14px rgba(0,0,0,.32);
            }
            #cpl-install[hidden] { display: none; }
            #cpl-install .cpl-install-btn {
                background: linear-gradient(#ffd23f,#ffb300); color: #5a3b00; border: none; border-radius: 999px;
                padding: 6px 14px; font-weight: bold; cursor: pointer; white-space: nowrap;
            }
            #cpl-install .cpl-install-close { background: none; border: none; color: #cfe6f5; font-size: 20px; cursor: pointer; line-height: 1; padding: 0 2px; }

            /* rotate-to-play prompt (touch devices held in portrait) */
            #cpl-rotate { display: none; }
            @media (pointer: coarse) and (orientation: portrait) {
                /* match the rotate overlay's blue so the iOS home-indicator safe-area strip below it
                   blends in instead of flashing the light page background. */
                html, body { background: #1163ac; }
                #cpl-nav, #cpl-stage, #cpl-footer, #cpl-landing { display: none !important; }
                #cpl-rotate {
                    display: flex; position: fixed; inset: 0; z-index: 9999;
                    flex-direction: column; align-items: center; justify-content: center; gap: 20px;
                    background: radial-gradient(circle at 50% 36%, #3aa9e8, #0e5fa8);
                    color: #fff; text-align: center; padding: 32px;
                }
                #cpl-rotate .phone {
                    width: 60px; height: 100px; border: 6px solid #fff; border-radius: 12px;
                    box-shadow: inset 0 0 0 2px rgba(255,255,255,.25);
                    animation: cpl-tilt 1.8s ease-in-out infinite;
                }
                #cpl-rotate h2 { font-family: 'Burbank Big Regular', 'ProximaNova', sans-serif; font-size: 26px; margin: 0; text-shadow: 0 2px 0 rgba(0,0,0,.18); }
                #cpl-rotate p { margin: 0; font-size: 15px; opacity: .92; max-width: 280px; line-height: 1.4; }
            }
            @keyframes cpl-tilt { 0%, 45% { transform: rotate(0); } 65%, 100% { transform: rotate(-90deg); } }
        </style>

        <!-- Fonts: loaded once via WebFontLoader (see src/data/fonts.js), which fetches
             fonts.css and force-loads each family so canvas text is ready. The old
             duplicate <link rel=stylesheet href=fonts.css> was removed (it re-fetched the
             same CSS + every woff2 a second time on first load). -->
        <script src="assets/scripts/lib/webfont.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>"></script>

        <!-- Phaser (pinned; Subresource Integrity guards against CDN compromise) -->
        <script src="https://cdn.jsdelivr.net/npm/phaser@3.80.1/dist/phaser.min.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>" integrity="sha384-Fi7F0CYQBHYa+s2vvYJeiqvOQf3tuZ28vafRGXvMt7ijxNTVf3+eXPkNRIUi9JD2" crossorigin="anonymous"></script>
        <script src="assets/scripts/lib/phaser-cachebuster.min.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>"></script>

        <!-- Ruffle (pinned nightly — stable 0.2.0 cannot run the classic CP minigames; SRI-pinned) -->
        <script src="assets/scripts/lib/ruffle/ruffle.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>"></script>

        <!-- Client bundle -->
        <script src="assets/scripts/client/yukon.bundle.min.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>"></script>
    </head>

    <body>
        <header id="cpl-nav">
            <input type="checkbox" id="cpl-nav-toggle" hidden>
            <label for="cpl-nav-toggle" class="cpl-burger" aria-label="Menu">☰</label>
            <div class="side">
                <a class="home" href="https://clubpenguinlive.net">Home</a>
                <a href="https://clubpenguinlive.net/#news">What's New?</a>
                <a href="/pages/rules.html">Community Rules</a>
                <a href="/pages/terms.html">Legal</a>
                <a href="/pages/help.html">Help</a>
            </div>
            <div class="side right">
                <button type="button" class="cpl-iconbtn" id="cpl-fullscreen" aria-label="Full screen" title="Full screen">
                    <svg class="ic-expand" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M16 21h5v-5M8 21H3v-5"/></svg>
                    <svg class="ic-compress" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h5V3M21 8h-5V3M21 16h-5v5M3 16h5v5"/></svg>
                </button>
                <button type="button" class="cpl-navbtn" id="cpl-logout">Log Out</button>
            </div>
        </header>

        <div id="cpl-stage">
            <div id="game-wrap"><div id="game" class="game"></div></div>
        </div>

        <footer id="cpl-footer">
            <nav>
                <a href="https://clubpenguinlive.net">Home</a>·<a href="https://clubpenguinlive.net/#support">Community</a>·<a href="/pages/help.html">Help</a>·<a href="/pages/terms.html">Terms of Service</a>·<a href="/pages/privacy.html">Privacy Policy</a>·<a href="/account">Reset Your Password</a>
            </nav>
            <span>© 2026 Club Penguin Live. A fan-run private server, not affiliated with or endorsed by The Walt Disney Company.</span>
        </footer>

        <!-- Front-page animated landing -->
        <div id="cpl-landing">
            <div id="cpl-snow"></div>
            <div id="cpl-install" hidden>
                <span class="cpl-install-text"></span>
                <button type="button" class="cpl-install-btn" hidden>Install</button>
                <button type="button" class="cpl-install-close" aria-label="Dismiss">&times;</button>
            </div>
            <div class="cpl-cta">
                <p class="tagline">Waddle around and meet new friends!</p>
                <button type="button" class="cpl-play" id="cpl-play">Play Now</button>
                <a class="cpl-create" id="cpl-create" href="/create">Create a Penguin</a>
            </div>
        </div>

        <div id="cpl-rotate" aria-hidden="true">
            <div class="phone"></div>
            <h2>Please rotate your device</h2>
            <p>Club Penguin Live plays best in landscape. Turn your phone sideways to waddle on.</p>
        </div>

        <!-- Landing logic is external (not inline) to satisfy the strict CSP script-src 'self'. -->
        <script src="assets/scripts/lib/landing.js?v=<%= htmlWebpackPlugin.options.templateParameters.timestamp %>"></script>
    </body>

</html>
